+package agent_runtime_endpoint
+
+import (
+	svcapitypes "github.com/aws-controllers-k8s/bedrockagentcorecontrol-controller/apis/v1alpha1"
+	svcsdk "github.com/aws/aws-sdk-go-v2/service/bedrockagentcorecontrol"
+)
+
+func setObservedRuntimeVersion(resource *svcapitypes.AgentRuntimeEndpoint, response *svcsdk.GetAgentRuntimeEndpointOutput) {
+	if response.TargetVersion != nil {
+		resource.Spec.AgentRuntimeVersion = response.TargetVersion
+	} else if response.LiveVersion != nil {
+		resource.Spec.AgentRuntimeVersion = response.LiveVersion
+	}
+}
